    "details_SKH 이천_SOMA-2000::SOMA-H19-0903": {
        "logs": [
            {
                "content": "Standard Solution, Sampling & Skimmer Cone, Ion Lens",
                "date": "2026-02-04",
                "id": 1770334523208.0269,
                "maintItem": "Sampling & Skimmer Cone",
                "memo": "1. 정기 용액 교체 \n - 용액 상태 : STD3 감도 정상\n\n2. PC 재부팅 및 설비 정상화\n\n3. ICPMS 유지 관리 진행\n - Tuning 진행 : 특이사항 없음\n - Parameter 값 정상 범위\n - Mode 별 Metal 감도 특이사항 없음",
                "type": "PM",
