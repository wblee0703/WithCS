# 보안 및 로컬 설정 파일 무시
.env

# 파이썬 캐시 및 로그 무시
__pycache__/
*.pyc
logs/
backups/

# 데이터베이스 파일 무시
withtech.db
*.db

# 2. 앞으로 GitHub에 올리지 않을 폴더/파일 목록을 .gitignore에 기록
echo "data/" >> .gitignore
echo "logs/" >> .gitignore
echo "backups/" >> .gitignore
echo ".env" >> .gitignore
echo "__pycache__/" >> .gitignore
echo "*.db" >> .gitignore
